# ---------------------------------------------------------------------------
# AAC configuration. Copy to .env and fill in the values:
#   cp .env.example .env && chmod 600 .env
# Never commit .env: it contains secrets.
# ---------------------------------------------------------------------------

# Public HTTPS URL of your instance, without trailing slash (e.g. https://coach.example.com)
PUBLIC_URL=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web")
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google email of the administrator (approves new users)
ADMIN_EMAIL=

# Random secret used to encrypt Intervals.icu API keys (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Do not change it later, or stored keys can no longer be decrypted.
APP_SECRET=

# Optional: initial age of the first (admin) user, used to estimate max HR (default 33).
# Each user can change their age later in Account.
# ATHLETE_AGE=33

# Optional: sync schedule (default: every 30 minutes)
# SYNC_CRON=*/15 * * * *

# Optional: listen address and port on the host (default 127.0.0.1:3000)
# BIND_ADDR=127.0.0.1
# HOST_PORT=3000

# Optional, single-user mode only (no Google login): Intervals.icu credentials
# INTERVALS_API_KEY=
# INTERVALS_ATHLETE_ID=i123456

# Optional: extra CA certificate for networks with TLS inspection
# EXTRA_CA_FILE=/path/to/ca.pem

# Optional: image tag for all services (ghcr.io/airluke19/aac-backend, -frontend, -backup).
# latest = branch main (default), staging = branch staging, sha-<commit> = a precise build (rollback).
# AAC_TAG=latest

# Optional: several instances on one host (e.g. production and staging): Compose project
# and prefix of containers/volumes. Default prefix: aac.
# COMPOSE_PROJECT_NAME=ai-adaptive-coach
# AAC_PREFIX=aac

# Nightly backup service: keep it on (remove it only on a test instance without its own data).
COMPOSE_PROFILES=backup

# Optional: off = single-user mode without sign-in; the backend then refuses requests from the internet.
# LOGIN_GOOGLE=on

# Strava come fonte di dati (facoltativo). Crea un'app su https://www.strava.com/settings/api:
# Authorization Callback Domain = il dominio di PUBLIC_URL (es. aac.run). Senza questi valori l'opzione Strava non compare.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
