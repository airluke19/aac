---
// Tema chiaro/scuro come nell'app: un pulsante rotondo (sole/luna) con il suono dell'interruttore
const en = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const etichetta = en ? 'Light/dark theme' : 'Tema chiaro/scuro';
---
<button type="button" class="aac-ico aac-tema" aria-label={etichetta} title={etichetta}>
  <svg class="ico-sole" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="ico-luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button>
<script>
  import { suonoInterruttore } from '../scripts/suono';
  for (const b of document.querySelectorAll<HTMLButtonElement>('.aac-tema')) {
    b.addEventListener('click', () => {
      const nuovo = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      suonoInterruttore(nuovo === 'light');
      document.documentElement.dataset.theme = nuovo;
      try { localStorage.setItem('starlight-theme', nuovo); } catch { /* solo comodità */ }
    });
  }
</script>
